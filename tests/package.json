{
  "name": "shopee-list-tests",
  "private": true,
  "description": "Logic tests need nothing installed. Rules and e2e tests need npm ci and Java 21+ (Firestore emulator); e2e also needs the repo served on port 8765.",
  "scripts": {
    "test:logic": "node --test logic.test.mjs",
    "pretest:rules": "cp ../firestore.rules .",
    "test:rules": "firebase emulators:exec --only firestore --project demo-shopee-list \"node --test rules.test.mjs\"",
    "pretest:e2e": "cp ../firestore.rules .",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project shopee-list-dea0e \"node e2e.cjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "15.34.0",
    "playwright": "^1.64.1"
  }
}
